# LandLock backend settings. Copy this file to ".env" in the same folder and edit as needed.
# .env is git-ignored. Never put real secrets or private keys in this example file.
# Variables already set in your shell take priority over values in .env.

# Port for the API (the frontend expects http://localhost:4000/api by default)
PORT=4000

# "production" disables demo endpoints and automatic signing-key generation
NODE_ENV=development

# Demo-only endpoints (/api/dev/reset, tamper, tamper-smart, attack). Off unless exactly "true".
# For a local hackathon demo you can also just run: npm run demo
LANDLOCK_DEMO_MODE=false

# Optional storage locations (leave empty for the defaults inside this folder)
# Folder holding data.json:
LANDLOCK_DATA_DIR=
# Folder for the signed ledger checkpoint (best kept on a different disk/machine than data.json):
LANDLOCK_TRUST_DIR=
# Path to the Ed25519 key file (default: keys.json in this folder). Keep it private and backed up.
LANDLOCK_KEY_FILE=

# "true" = never generate a signing key automatically; the key file must already exist
LANDLOCK_REQUIRE_KEY=false

# Optional extra permissions, e.g. sub_registrar:sale.mutate (comma-separated). Leave empty normally.
LANDLOCK_EXTRA_GRANTS=
