# LandLock monorepo: backend/ (Node/Express) + frontend/ (React/Vite)

# ---- Secrets & signing keys -------------------------------------------------
# Ed25519 Sub-Registrar signing key pair, auto-generated by keys.js on first run.
# Contains the PRIVATE key used to sign ledger entries - never commit.
keys.json
**/keys.json

# Any other private keys / certificates that may be added later
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Environment files (keep a sanitized .env.example if one is added)
.env
.env.*
!.env.example

# ---- Runtime data -------------------------------------------------------------
# backend/data/: data.json (JSON database), keys.json (private signing key),
# trusted/ (signed ledger checkpoint) and the lock file. Created at runtime; never commit.
backend/data/
# Lock file of a running server, and temp files of interrupted atomic writes
*.json.lock
*.tmp

# ---- Dependencies -----------------------------------------------------------
node_modules/

# ---- Build output -----------------------------------------------------------
dist/
dist-ssr/
build/
coverage/
*.local

# ---- Logs -------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Editor / OS ------------------------------------------------------------
**/.vscode/*
!**/.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini
